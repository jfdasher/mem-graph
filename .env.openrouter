# OpenRouter - OpenAI models
# Usage: memgraph --config .env.openrouter ingest "Your text here"

MEMGRAPH_LLM_API_KEY=${OPENROUTER_API_KEY}
MEMGRAPH_LLM_BASE_URL=https://openrouter.ai/api/v1/
MEMGRAPH_LLM_MODEL=openai/gpt-4o-mini
MEMGRAPH_LLM_EXTRA_HEADERS={"HTTP-Referer": "https://github.com/user/mem-graph", "X-Title": "mem-graph"}
